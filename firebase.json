{
  "hosting": [
    {
      "public": "web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "backend/**",
        "brainstorms/**"
      ],
      "headers": [
        {
          "source": "**/*.apk",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/vnd.android.package-archive"
            },
            {
              "key": "Content-Disposition",
              "value": "attachment; filename=\"Don-Pepito.apk\""
            }
          ]
        }
      ],
      "target": "principal"
    },
    {
      "public": "web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "backend/**",
        "brainstorms/**"
      ],
      "headers": [
        {
          "source": "**/*.apk",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/vnd.android.package-archive"
            },
            {
              "key": "Content-Disposition",
              "value": "attachment; filename=\"Don-Pepito.apk\""
            }
          ]
        }
      ],
      "target": "corto"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}